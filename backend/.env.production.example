# =====================================================================================================
# Meridian CRM - example PRODUCTION environment (mock values)
#
# Copy to your host's environment settings (or to backend/.env on a server) and replace every value marked
# REPLACE_ME. Never commit the real file. Variables you leave out use the defaults in app/core/config.py.
# Local development uses backend/.env.example instead.
# =====================================================================================================

# ---- Application -------------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
# 48+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable: it encrypts stored secrets (passport numbers, TFNs, saved SMTP passwords).
SECRET_KEY=REPLACE_ME_with_a_long_random_string_generated_as_above_000000000000

# ---- Database (Neon, Sydney) --------------------------------------------------------------------------
# Pooled endpoint (host contains "-pooler") for the app.
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-example-name-123456-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct endpoint (same host WITHOUT "-pooler"): migrations and building new firms' workspaces.
DATABASE_URL_DIRECT=postgresql://neondb_owner:REPLACE_ME@ep-example-name-123456.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Redis (rate limiting; queue for the optional Celery worker) -----------------------------------------
# Any managed Redis, e.g. Upstash ("rediss://" = TLS). If Redis is missing, rate limiting is skipped and
# e-mails are sent by the API itself (see EMAIL_DELIVERY).
REDIS_URL=rediss://default:REPLACE_ME@example-redis-12345.upstash.io:6379/0

# ---- Web ---------------------------------------------------------------------------------------------
# The address people open. Links in e-mails (sign-up confirmation, password reset, invitations) use it,
# and browser requests from any other origin are refused.
PUBLIC_APP_URL=https://crm.yourfirm.com.au
# Other addresses that serve the app (comma separated), e.g. a staging domain. Usually empty.
EXTRA_ALLOWED_ORIGINS=
# Must stay true in production (start-up refuses false).
MFA_REQUIRED_FOR_STAFF=true

# ---- Sign-up -----------------------------------------------------------------------------------------
SIGNUP_ENABLED=true
SIGNUP_VERIFICATION_HOURS=24
# Pre-built workspaces kept ready so a new firm's workspace opens in seconds.
SIGNUP_WARM_POOL_SIZE=2
# Reject passwords that appear in known data breaches (Have I Been Pwned; only 5 hash characters are sent).
PASSWORD_BREACH_CHECK=true

# ---- E-mail: Zoho Mail over SMTP -----------------------------------------------------------------------
EMAIL_BACKEND=smtp
# The mailbox you sign in to Zoho with (or one of its aliases): Zoho refuses to send "From" other addresses.
# In a hosting dashboard, enter the value without the surrounding quotes.
EMAIL_FROM="Meridian CRM <no-reply@yourfirm.com.au>"
# Zoho shows the exact server in Zoho Mail -> Settings -> Mail Accounts -> IMAP/SMTP (POP/IMAP Access).
#   Accounts on zoho.com.au (Australian data centre): smtp.zoho.com.au
#   Accounts on zoho.com: smtp.zoho.com (free/personal) or smtppro.zoho.com (paid organisation accounts)
SMTP_HOST=smtp.zoho.com.au
# 587 with STARTTLS (below). Port 465 (SSL) also works once SMTP_SECURITY=ssl is available (see the end).
SMTP_PORT=587
SMTP_STARTTLS=true
# Full mailbox address.
SMTP_USERNAME=no-reply@yourfirm.com.au
# With two-factor sign-in on the Zoho account (recommended), create an application-specific password:
# Zoho Accounts -> Security -> App Passwords. Your normal Zoho password will be refused.
SMTP_PASSWORD=REPLACE_ME_zoho_app_specific_password
# "inline": the API sends e-mail itself (use when you don't run the Celery worker).
# "queue": the Celery worker sends it (deploy the worker and scheduler).
EMAIL_DELIVERY=inline

# ---- Optional settings available after the next update (ignored by the current version) ------------------
# Zoho on port 465 with implicit SSL instead of 587/STARTTLS:
#   SMTP_PORT=465
#   SMTP_SECURITY=ssl
# Zoho ZeptoMail (transactional e-mail over HTTPS; use it if your host blocks outbound SMTP ports):
#   EMAIL_BACKEND=zeptomail
#   ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email   # ZeptoMail shows your account's API URL
#   ZEPTOMAIL_TOKEN=REPLACE_ME_send_mail_token               # ZeptoMail -> Mail Agents -> SMTP/API
# E-mail delivery choice made automatically (worker if one is running, otherwise the API):
#   EMAIL_DELIVERY=auto
# Confirmation e-mail before a new firm's workspace is created: auto | required | off.
#   SIGNUP_EMAIL_VERIFICATION=auto
# Workspace (address) whose System Administrators may change platform e-mail settings in Setup.
#   PLATFORM_OPERATOR_WORKSPACE=main

# ---- Background worker (optional) ----------------------------------------------------------------------
# Same image and variables, started with:
#   celery -A app.worker.celery_app worker --loglevel=INFO
#   celery -A app.worker.celery_app beat --loglevel=INFO      (exactly one instance)
# Needed for reminders, scheduled reports and scheduled marketing sends. Uvicorn worker processes:
WEB_CONCURRENCY=2

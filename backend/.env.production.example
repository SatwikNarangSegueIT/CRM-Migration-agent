# =====================================================================================================
# Segue CRM - example PRODUCTION environment (mock values)
#
# Copy to your host's environment settings (or to backend/.env on a server) and replace every value marked
# REPLACE_ME. Never commit the real file. Variables you leave out use the defaults in app/core/config.py.
# Local development uses backend/.env.example instead.
# =====================================================================================================

# ---- Application -------------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
# 48+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable: it encrypts stored secrets (passport numbers, TFNs, saved SMTP passwords).
SECRET_KEY=REPLACE_ME_with_a_long_random_string_generated_as_above_000000000000

# ---- Database (Neon, Sydney) --------------------------------------------------------------------------
# Pooled endpoint (host contains "-pooler") for the app.
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-example-name-123456-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct endpoint (same host WITHOUT "-pooler"): migrations and building new firms' workspaces.
DATABASE_URL_DIRECT=postgresql://neondb_owner:REPLACE_ME@ep-example-name-123456.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Redis (rate limiting; queue for the optional Celery worker) -----------------------------------------
# Any managed Redis, e.g. Upstash ("rediss://" = TLS). If Redis is missing, rate limiting is skipped and
# e-mails are sent by the API itself (see EMAIL_DELIVERY).
REDIS_URL=rediss://default:REPLACE_ME@example-redis-12345.upstash.io:6379/0

# ---- Web ---------------------------------------------------------------------------------------------
# The address people open. Links in e-mails (sign-up confirmation, password reset, invitations) use it,
# and browser requests from any other origin are refused.
PUBLIC_APP_URL=https://crm.yourfirm.com.au
# Other addresses that serve the app (comma separated), e.g. a staging domain. Usually empty.
EXTRA_ALLOWED_ORIGINS=
# Must stay true in production (start-up refuses false).
MFA_REQUIRED_FOR_STAFF=true

# ---- Sign-up -----------------------------------------------------------------------------------------
SIGNUP_ENABLED=true
SIGNUP_VERIFICATION_HOURS=24
# Pre-built workspaces kept ready so a new firm's workspace opens in seconds.
SIGNUP_WARM_POOL_SIZE=2
# Workspaces kept ready, already set up, for each profession (sign-up then takes about a second)
SIGNUP_READY_PER_DOMAIN=1
# Reject passwords that appear in known data breaches (Have I Been Pwned; only 5 hash characters are sent).
PASSWORD_BREACH_CHECK=true

# ---- E-mail: Zoho ZeptoMail (transactional e-mail over HTTPS) ------------------------------------------
# Sends sign-up confirmations, password resets, invitations, reminders and client e-mails. A platform
# administrator can also change these without a redeploy in Setup -> E-mail & Sign-up, and send a test e-mail.
#
# Set-up in ZeptoMail (zeptomail.zoho.com, or your data centre's site):
#   1. Mail Agents -> Add Mail Agent (e.g. "Segue CRM").
#   2. Domains -> add your sending domain and add the DKIM and CNAME records it shows to your DNS. Wait until
#      both show "Verified": ZeptoMail refuses to send from an unverified domain.
#   3. Mail Agents -> (your agent) -> SMTP/API -> API -> copy the "Send Mail token".
EMAIL_BACKEND=zeptomail
# The Send Mail token. Paste it with or without the leading "Zoho-enczapikey ". Keep it secret.
ZEPTOMAIL_TOKEN=REPLACE_ME_zeptomail_send_mail_token
# The API address of your ZeptoMail account's data centre (shown next to the token):
#   https://api.zeptomail.com/v1.1/email      United States
#   https://api.zeptomail.in/v1.1/email       India
#   https://api.zeptomail.eu/v1.1/email       Europe
#   https://api.zeptomail.com.au/v1.1/email   Australia
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# The sender. The address must be on the domain verified in step 2.
# In a hosting dashboard, enter the value without the surrounding quotes.
EMAIL_FROM="Segue CRM <no-reply@yourfirm.com.au>"
# Optional: a bounce address on a bounce domain set up in the Mail Agent. Leave empty to use ZeptoMail's.
ZEPTOMAIL_BOUNCE_ADDRESS=
# "auto": the Celery worker sends e-mail when one is running, otherwise the API sends it itself.
EMAIL_DELIVERY=auto

# Alternative: Zoho Mail over SMTP (only if you can't use ZeptoMail; some hosts block SMTP ports).
#   EMAIL_BACKEND=smtp
#   SMTP_HOST=smtppro.zoho.in        # Zoho Mail -> Settings -> Mail Accounts -> IMAP/SMTP shows the exact host
#   SMTP_PORT=465                    # 465 with SSL, or 587 with STARTTLS
#   SMTP_SECURITY=ssl
#   SMTP_USERNAME=no-reply@yourfirm.com.au
#   SMTP_PASSWORD=REPLACE_ME_zoho_app_specific_password

# ---- Sign-up confirmation and platform administration -----------------------------------------------------
# Confirmation e-mail before a new firm's workspace is created: off | auto | required.
# Leave "off" until a test e-mail arrives (Setup -> E-mail & Sign-up -> Send test e-mail), then set "auto"
# (or "required") so new firms confirm their e-mail address before their workspace is created.
SIGNUP_EMAIL_VERIFICATION=off
# Workspace (its address) whose System Administrators may change the platform e-mail settings. Default: the
# first workspace (main).
PLATFORM_OPERATOR_WORKSPACE=main

# ---- Background worker (optional) ----------------------------------------------------------------------
# Same image and variables, started with:
#   celery -A app.worker.celery_app worker --loglevel=INFO
#   celery -A app.worker.celery_app beat --loglevel=INFO      (exactly one instance)
# Needed for reminders, scheduled reports and scheduled marketing sends. Uvicorn worker processes:
WEB_CONCURRENCY=2

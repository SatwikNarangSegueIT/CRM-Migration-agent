# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
# true = JSON logs (production); false = readable text logs (local dev)
LOG_JSON=false
# Required (>= 32 chars) in staging/production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- Database (Neon) ----
# Pooled endpoint (host contains "-pooler") for the API and workers.
# Example: postgresql://user:password@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Local development without Neon (docker compose "db" service):
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Direct (non-pooled) endpoint, used by Alembic migrations. Leave empty to reuse DATABASE_URL.
DATABASE_URL_DIRECT=
# Leave empty to auto-detect from the host name; set true/false to override.
DATABASE_DISABLE_PREPARED_STATEMENTS=
# Cap on a single SQL statement (ms) on direct connections; for the pooled endpoint use ALTER ROLE (docs/operations.md).
DB_STATEMENT_TIMEOUT_MS=30000

# ---- Redis (Celery broker / results) ----
REDIS_URL=redis://localhost:6379/0

# ---- Web / auth ----
PUBLIC_APP_URL=http://localhost:5173
# Mandatory TOTP MFA for staff. Must stay true in production; may be disabled for local development.
MFA_REQUIRED_FOR_STAFF=false
# Reject passwords found in known data breaches (Have I Been Pwned, k-anonymity). Fails open if unreachable.
PASSWORD_BREACH_CHECK=true

# ---- E-mail ----
# "console" prints e-mails to the log (development); "smtp" sends them.
EMAIL_BACKEND=console
# "auto" = the Celery worker sends e-mail when one runs, otherwise the API does; "queue" | "inline" force one.
EMAIL_DELIVERY=auto
# With EMAIL_BACKEND=console and SIGNUP_EMAIL_VERIFICATION=off, sign-up creates the workspace straight away
# (no mail server needed locally). Set "required" to test the confirmation e-mail (the link is in the log).
SIGNUP_EMAIL_VERIFICATION=off
# Zoho Mail SMTP: see .env.production.example. SMTP_SECURITY = starttls (587) | ssl (465) | none.
SMTP_SECURITY=
EMAIL_FROM="MigrateCRM <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
